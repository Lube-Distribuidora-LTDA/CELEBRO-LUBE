# Cérebro da Lube — credenciais do app local (copie para ENV, na mesma pasta, e preencha).
# O ENV nunca vai para o Git (está no .gitignore). Só o programa lê; nenhum valor aparece em tela ou log.
# Linha em branco ou sem valor = a peça fica desligada (o resto continua funcionando).

# --- Claude (API da Anthropic). Sem a chave, o Jarvis liga com o cérebro de teste (frases prontas).
ANTHROPIC_API_KEY=

# --- DATA WAREHOUSE (Supabase), os mesmos das ETLs. O Jarvis só LÊ (transação READ ONLY).
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=
SUPABASE_DB_NAME=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# --- Caixa cpd@ (Locaweb), os mesmos nomes do Gestão TI.
# Locaweb: host email-ssl.com.br (o certificado é *.email-ssl.com.br), IMAP 993 e SMTP 465.
IMAP_HOST=
IMAP_PORT=
IMAP_USER=
IMAP_PASS=
IMAP_PASTA=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NOME=

# --- Pastas (opcional). Padrão do vault: <perfil>\OneDrive - Lube\CEREBRO DA LUBE
VAULT_DIR=
# Raízes que o Jarvis pode ler, separadas por ; (padrão: a pasta "OneDrive - Lube" e P:\)
ARQUIVOS_RAIZES=

# --- Testes e ajustes (opcional)
# 1 = cérebro de teste mesmo com a chave (o argumento --simulado faz o mesmo)
JARVIS_SIMULADO=
# 1 / 0 = força ligar / desligar a pesquisa na internet direto no Haiku (padrão: pergunta à API na partida)
JARVIS_BUSCA_HAIKU=
# Porta do app local (padrão 8790)
JARVIS_PORTA=
